{
  "name": "@dos/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:generate": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts migration:generate src/database/migrations/AutoMigration",
    "migration:run": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts migration:run",
    "migration:revert": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts migration:revert",
    "seed:dev": "ts-node --project tsconfig.json src/database/seeds/dev.seed.ts",
    "storage:ensure-bucket": "ts-node --project tsconfig.json scripts/ensure-s3-bucket.ts",
    "token:admin:dev": "ts-node --project tsconfig.json scripts/generate-dev-admin-token.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --watchman=false",
    "test:unit": "jest --watchman=false --runInBand --selectProjects unit",
    "test:integration": "jest --watchman=false --runInBand --selectProjects integration",
    "test:e2e": "jest --watchman=false --runInBand --selectProjects e2e",
    "test:coverage": "jest --watchman=false --coverage",
    "openapi:generate": "ts-node --project tsconfig.json scripts/generate-openapi.ts",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@dos/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.15",
    "bullmq": "^5.41.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.7.3"
  }
}
