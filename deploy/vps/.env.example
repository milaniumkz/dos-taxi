# Copy to deploy/vps/.env on the VPS and fill secrets.

COMPOSE_PROJECT_NAME=dos

# Public domains. Point DNS A records to the VPS IP before enabling TLS.
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com

# Images are built locally on the VPS from this repo.
API_IMAGE=dos-api:vps
ADMIN_IMAGE=dos-admin:vps

# Database
POSTGRES_DB=platform_db
POSTGRES_USER=platform
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://platform:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/platform_db

# Redis
REDIS_URL=redis://redis:6379

# API
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=https://admin.example.com,https://dos-taxi-passenger.web.app,https://dos-taxi-driver.web.app,https://dos-taxi.web.app
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_DEV_BYPASS=false
OTP_DEBUG_RESPONSE_ENABLED=false
APP_REVIEW_OTP_CODE=2468
APP_REVIEW_PHONE_NUMBERS=+77000000001,+77000000002

# SMS / WhatsApp via Wappi
NOTIFICATIONS_SMS_STUB=false
NOTIFICATIONS_SMS_PROVIDER=wappi
WAPPI_API_BASE_URL=https://wappi.pro
WAPPI_TOKEN=CHANGE_ME_WAPPI_TOKEN
WAPPI_PROFILE_ID=CHANGE_ME_WAPPI_PROFILE_ID
WAPPI_BOT_ID=dos-taxi

# Push. Leave stub=true until Firebase service account is configured.
NOTIFICATIONS_PUSH_STUB=true
FIREBASE_PROJECT_ID=dos-taxi
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# S3-compatible object storage for executor document uploads.
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET=dos-taxi-files
S3_FORCE_PATH_STYLE=false

# Geo
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru/1.x
CURRENCY_RUB_KZT_FALLBACK_RATE=6.20

# Admin
ADMIN_API_URL=https://api.example.com/api/v1
ADMIN_API_TOKEN=CHANGE_ME_GENERATE_WITH_scripts_generate_admin_token.sh
ADMIN_BASIC_AUTH_USERNAME=admin
ADMIN_BASIC_AUTH_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
