# Copy to deploy/.env.api.yaml and fill real production/staging values.
NODE_ENV: production
API_PREFIX: api/v1
CORS_ALLOWED_ORIGINS: "https://dos-taxi.web.app,https://dos-taxi.firebaseapp.com,https://dos-taxi-passenger.web.app,https://dos-taxi-passenger.firebaseapp.com,https://dos-taxi-driver.web.app,https://dos-taxi-driver.firebaseapp.com"

DATABASE_URL: postgresql://platform:CHANGE_ME@localhost/platform_db?host=/cloudsql/dos-taxi:asia-south1:dos-postgres
REDIS_URL: redis://CHANGE_ME_REDIS_HOST:6379

JWT_SECRET: CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN: 15m
JWT_REFRESH_EXPIRES_IN: 30d

OTP_LENGTH: "4"
OTP_TTL_SECONDS: "300"
OTP_MAX_ATTEMPTS: "3"
OTP_DEV_BYPASS: "false"
OTP_DEBUG_RESPONSE_ENABLED: "false"
APP_REVIEW_OTP_CODE: "2468"
APP_REVIEW_PHONE_NUMBERS: "+77000000001,+77000000002"

S3_ENDPOINT: https://storage.googleapis.com
S3_REGION: auto
S3_ACCESS_KEY_ID: CHANGE_ME_GCS_HMAC_ACCESS_ID
S3_SECRET_ACCESS_KEY: CHANGE_ME_GCS_HMAC_SECRET
S3_BUCKET: dos-taxi-files
S3_FORCE_PATH_STYLE: "false"

NOTIFICATIONS_SMS_STUB: "false"
NOTIFICATIONS_SMS_PROVIDER: smsc
SMSC_LOGIN: CHANGE_ME_SMSC_LOGIN
SMSC_PASSWORD: CHANGE_ME_SMSC_PASSWORD
SMSC_SENDER: ""
NOTIFICATIONS_PUSH_STUB: "true"

FIREBASE_PROJECT_ID: dos-taxi
FIREBASE_CLIENT_EMAIL: ""
FIREBASE_PRIVATE_KEY: ""

NOMINATIM_BASE_URL: https://nominatim.openstreetmap.org
OSRM_BASE_URL: https://router.project-osrm.org
CURRENCY_RUB_KZT_FALLBACK_RATE: "6.20"
